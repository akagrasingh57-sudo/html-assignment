/* Simple Dashboard Layout using CSS Grid and Named Areas */

.dashboard {
	display: grid;
	grid-template-areas:
		"header header header"
		"sidebar main main"
		"footer footer footer";
	grid-template-columns: 200px 1fr 1fr;
	grid-template-rows: 60px 1fr 40px;
	gap: 16px;
	height: 100vh;
}

.header {
	grid-area: header;
	background: #4f8cff;
	color: #fff;
	display: flex;
	align-items: center;
	padding: 0 20px;
	font-size: 1.5rem;
}

.sidebar {
	grid-area: sidebar;
	background: #e3e7ee;
	padding: 20px;
}

.main {
	grid-area: main;
	background: #fff;
	padding: 20px;
}

.footer {
	grid-area: footer;
	background: #222;
	color: #fff;
	display: flex;
	align-items: center;
	justify-content: center;
	font-size: 1rem;
}
