/* Design note: Warm neutrals and deep teal accents create a calm, cohesive
	 look across pages. Responsive grids, clear type, and generous spacing keep
	 the project readable on both desktop and mobile. */

:root {
	--ink: #24313a;
	--muted: #62717a;
	--paper: #fbfaf7;
	--surface: #fff;
	--brand: #176b68;
	--brand-dark: #10514f;
	--accent: #e5b765;
	--line: #e1e6e2;
	--radius: 14px;
	--content-width: 1100px;
	font-family: "Segoe UI", Arial, sans-serif;
	color: var(--ink);
	background: var(--paper);
}

*,
*::before,
*::after { box-sizing: border-box; }

html { scroll-behavior: smooth; }

body {
	margin: 0;
	background: var(--paper);
	color: var(--ink);
	font-size: 1rem;
	line-height: 1.65;
}

img, video { display: block; max-width: 100%; }
img { height: auto; border-radius: var(--radius); }
a { color: var(--brand); text-underline-offset: .2em; }
a:hover { color: var(--brand-dark); }
:focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; }

h1, h2, h3, h4 {
	margin: 0 0 .65em;
	line-height: 1.15;
	letter-spacing: -.025em;
}
h1 { font-size: clamp(2.4rem, 6vw, 4.25rem); }
h2 { font-size: clamp(1.8rem, 4vw, 2.7rem); }
h3 { font-size: 1.35rem; }
p { margin: 0 0 1rem; }

.container,
.site-header__inner,
.site-footer__inner {
	width: min(var(--content-width), calc(100% - 2.5rem));
	margin-inline: auto;
}

.site-header {
	position: sticky;
	z-index: 5;
	top: 0;
	border-bottom: 1px solid var(--line);
	background: rgb(251 250 247 / 95%);
	backdrop-filter: blur(10px);
}
.site-header__inner,
.site-nav,
.site-nav__list { display: flex; align-items: center; }
.site-header__inner {
	min-height: 72px;
	justify-content: space-between;
	gap: 1.5rem;
}
.site-logo {
	color: var(--ink);
	font-size: 1.2rem;
	font-weight: 800;
	text-decoration: none;
}
.site-nav__list {
	flex-wrap: wrap;
	gap: .4rem 1.4rem;
	margin: 0;
	padding: 0;
	list-style: none;
}
.site-nav a {
	color: var(--muted);
	font-weight: 650;
	text-decoration: none;
}
.site-nav a:hover,
.site-nav a[aria-current="page"] { color: var(--brand); }

.button,
button,
input[type="submit"] {
	display: inline-flex;
	min-height: 44px;
	align-items: center;
	justify-content: center;
	padding: .65rem 1.15rem;
	border: 0;
	border-radius: 999px;
	background: var(--brand);
	color: #fff;
	font: inherit;
	font-weight: 700;
	text-decoration: none;
	cursor: pointer;
}
.button:hover,
button:hover,
input[type="submit"]:hover { background: var(--brand-dark); color: #fff; }
.button--secondary {
	border: 1px solid var(--line);
	background: var(--surface);
	color: var(--ink);
}

.hero {
	display: grid;
	min-height: min(650px, 80vh);
	align-items: center;
	padding-block: clamp(4rem, 10vw, 8rem);
	background: radial-gradient(ellipse at 85% 20%, #e3efe9, transparent 38%);
}
.hero__content { max-width: 720px; }
.eyebrow {
	margin-bottom: 1rem;
	color: var(--brand);
	font-size: .78rem;
	font-weight: 800;
	letter-spacing: .13em;
	text-transform: uppercase;
}
.hero__description,
.section-intro { max-width: 650px; color: var(--muted); font-size: 1.15rem; }
.hero__actions { display: flex; flex-wrap: wrap; gap: .8rem; margin-top: 1.7rem; }

.section { padding-block: clamp(3.5rem, 8vw, 6rem); }
.section--tint, .page-banner { background: #edf3ef; }
.section-heading { max-width: 680px; margin-bottom: 2rem; }
.grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.25rem; }
.card {
	overflow: hidden;
	border: 1px solid var(--line);
	border-radius: var(--radius);
	background: var(--surface);
	box-shadow: 0 10px 28px rgb(36 49 58 / 7%);
}
.card__body { padding: 1.35rem; }
.card__body p, .muted { color: var(--muted); }
.card__link { font-weight: 700; }
.page-banner { padding-block: clamp(3.5rem, 8vw, 6rem); }
.page-banner h1 { max-width: 850px; font-size: clamp(2.4rem, 5vw, 3.7rem); }
.prose { max-width: 760px; }
.prose p, .prose li { color: #3d4a52; }
.prose h2, .prose h3 { margin-top: 2rem; }

.form { display: grid; max-width: 680px; gap: 1rem; }
.form label { display: grid; gap: .4rem; font-weight: 700; }
.form input, .form textarea, .form select {
	width: 100%;
	min-height: 44px;
	padding: .7rem .85rem;
	border: 1px solid #cbd3ce;
	border-radius: 8px;
	background: #fff;
	color: var(--ink);
	font: inherit;
}
.form textarea { min-height: 145px; resize: vertical; }
.site-footer { padding-block: 2.25rem; border-top: 1px solid var(--line); background: #f4f4ef; }
.site-footer__inner {
	display: flex;
	flex-wrap: wrap;
	justify-content: space-between;
	gap: 1rem 2rem;
	color: var(--muted);
	font-size: .92rem;
}
.site-footer p { margin: 0; }

@media (max-width: 760px) {
	.site-header { position: static; }
	.site-header__inner { align-items: flex-start; flex-direction: column; justify-content: center; gap: .5rem; padding-block: .9rem; }
	.grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}
@media (max-width: 520px) {
	.container, .site-header__inner, .site-footer__inner { width: calc(100% - 1.5rem); }
	.grid { grid-template-columns: 1fr; }
	.hero { min-height: auto; }
}
@media (prefers-reduced-motion: reduce) {
	html { scroll-behavior: auto; }
	*, *::before, *::after { transition-duration: .01ms !important; }
}
