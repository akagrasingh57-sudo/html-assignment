<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>Everyday Finds</title>
	<style>
		* { box-sizing: border-box; }
		body {
			margin: 0;
			padding: 40px 20px;
			background: #f5f6f1;
			color: #24312b;
			font-family: Arial, sans-serif;
		}
		main { max-width: 1100px; margin: 0 auto; }
		header { margin-bottom: 28px; }
		header p { margin: 0 0 8px; color: #68766e; }
		h1 { margin: 0; font-size: clamp(2rem, 5vw, 3rem); }
		.products {
			display: flex;
			flex-wrap: wrap;
			gap: 20px;
		}
		.product {
			flex: 1 1 230px;
			max-width: 350px;
			overflow: hidden;
			background: white;
			border: 1px solid #e4e8e2;
			border-radius: 14px;
			box-shadow: 0 5px 18px rgb(30 50 38 / 6%);
		}
		.product-image {
			display: grid;
			min-height: 190px;
			place-items: center;
			background: #e9efe8;
			font-size: 5rem;
		}
		.product:nth-child(2) .product-image { background: #f2e9dc; }
		.product:nth-child(3) .product-image { background: #e8eaf2; }
		.product:nth-child(4) .product-image { background: #f3e8e7; }
		.product:nth-child(5) .product-image { background: #e6efee; }
		.product:nth-child(6) .product-image { background: #f0eddf; }
		.details { padding: 18px; }
		h2 { margin: 0 0 8px; font-size: 1.1rem; }
		.description { min-height: 40px; margin: 0 0 16px; color: #68766e; font-size: .9rem; line-height: 1.45; }
		.product-footer { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
		.price { font-size: 1.1rem; font-weight: 700; }
		button {
			padding: 10px 14px;
			color: white;
			background: #315c46;
			border: 0;
			border-radius: 8px;
			font: inherit;
			cursor: pointer;
		}
		button:hover { background: #244735; }
		button:focus-visible { outline: 3px solid #8eb49b; outline-offset: 3px; }
		@media (max-width: 520px) {
			body { padding: 28px 16px; }
			.product { flex-basis: 100%; max-width: none; }
		}
	</style>
</head>
<body>
	<main>
		<header>
			<p>Thoughtful essentials for everyday living</p>
			<h1>Everyday Finds</h1>
		</header>
		<section class="products" aria-label="Product listing">
			<article class="product">
				<div class="product-image" role="img" aria-label="Ceramic mug">☕</div>
				<div class="details"><h2>Sunday Ceramic Mug</h2><p class="description">A handmade mug for slow mornings and warm drinks.</p><div class="product-footer"><span class="price">$18</span><button type="button">Add to cart</button></div></div>
			</article>
			<article class="product">
				<div class="product-image" role="img" aria-label="Canvas tote bag">👜</div>
				<div class="details"><h2>Market Canvas Tote</h2><p class="description">A sturdy, reusable carryall for errands and outings.</p><div class="product-footer"><span class="price">$24</span><button type="button">Add to cart</button></div></div>
			</article>
			<article class="product">
				<div class="product-image" role="img" aria-label="Desk lamp">💡</div>
				<div class="details"><h2>Arc Desk Light</h2><p class="description">Soft, focused light with a clean, compact design.</p><div class="product-footer"><span class="price">$42</span><button type="button">Add to cart</button></div></div>
			</article>
			<article class="product">
				<div class="product-image" role="img" aria-label="Potted plant">🪴</div>
				<div class="details"><h2>Little Leaf Plant</h2><p class="description">An easy-care green companion for your favorite shelf.</p><div class="product-footer"><span class="price">$16</span><button type="button">Add to cart</button></div></div>
			</article>
			<article class="product">
				<div class="product-image" role="img" aria-label="Headphones">🎧</div>
				<div class="details"><h2>Quiet Hours Headphones</h2><p class="description">Comfortable everyday listening, wherever you go.</p><div class="product-footer"><span class="price">$58</span><button type="button">Add to cart</button></div></div>
			</article>
			<article class="product">
				<div class="product-image" role="img" aria-label="Notebook">📓</div>
				<div class="details"><h2>Daybook Notebook</h2><p class="description">A simple place for notes, plans, sketches, and ideas.</p><div class="product-footer"><span class="price">$12</span><button type="button">Add to cart</button></div></div>
			</article>
		</section>
	</main>
</body>
</html>
